# Copy to .env. These are local-only defaults; replace for deployment.
POSTGRES_PASSWORD=local-development-only-change-me
DATABASE_URL=postgresql+psycopg://agriscan:local-development-only-change-me@db:5432/agriscan
REDIS_URL=redis://redis:6379/0
STORAGE_DIR=/data/images
STORAGE_BACKEND=local
ENVIRONMENT=development
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Optional production object storage. Use workload identity or secure environment bindings.
S3_BUCKET=
S3_ENDPOINT=
# DEMO_EMAIL=farmer@example.test
# DEMO_PASSWORD=enter-a-local-password-of-at-least-10-characters
# Frontend build-time values:
VITE_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty
VITE_GEOCODER_URL=https://nominatim.openstreetmap.org/search
