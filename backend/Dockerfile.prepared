# Cloud fallback: verified wheels are downloaded by scripts/prepare.sh, never committed.
FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
COPY requirements.lock .
COPY .wheels /wheels
RUN pip install --no-index --find-links=/wheels -r requirements.lock && rm -rf /wheels && useradd --create-home --uid 10001 agriscan && mkdir -p /data/images && chown -R agriscan /data
COPY --chown=agriscan app app
COPY --chown=agriscan alembic.ini .
COPY --chown=agriscan migrations migrations
USER agriscan
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
